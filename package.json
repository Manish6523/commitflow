{
  "name": "commitflow-vscode",
  "displayName": "CommitFlow",
  "description": "Visual Git commit history, interactive graph, side-by-side diff viewer, file history, branch manager and commit explorer.",
  "version": "0.5.0",
  "publisher": "commitflow",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "homepage": "https://github.com/Manish6523/commitflow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manish6523/commitflow"
  },
  "bugs": {
    "url": "https://github.com/Manish6523/commitflow/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "git graph",
    "git history",
    "diff",
    "commit",
    "git log",
    "source control",
    "scm",
    "git diff",
    "diff viewer",
    "file history",
    "branch",
    "visual git",
    "commit graph",
    "git tools",
    "stash",
    "analytics",
    "compare",
    "repository"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitflow-activitybar",
          "title": "CommitFlow",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "commitflow-activitybar": [
        {
          "id": "commitflow.sidebar",
          "name": "Source Control",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "commitflow.openDashboard",
        "title": "CommitFlow: Open Commit Dashboard",
        "category": "CommitFlow",
        "icon": "$(git-commit)"
      },
      {
        "command": "commitflow.refresh",
        "title": "CommitFlow: Refresh Repository",
        "category": "CommitFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "commitflow.search",
        "title": "CommitFlow: Search Commits",
        "category": "CommitFlow",
        "icon": "$(search)"
      },
      {
        "command": "commitflow.clearFilters",
        "title": "CommitFlow: Clear All Filters",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.openCommit",
        "title": "CommitFlow: Open Specific Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.compareCommits",
        "title": "CommitFlow: Compare Commits",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.openFileHistory",
        "title": "CommitFlow: Open File History",
        "category": "CommitFlow",
        "icon": "$(history)"
      },
      {
        "command": "commitflow.viewBranches",
        "title": "CommitFlow: View Branches & Tags",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.viewAnalytics",
        "title": "CommitFlow: View Analytics & Insights",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.checkoutCommit",
        "title": "CommitFlow: Checkout Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.cherryPick",
        "title": "CommitFlow: Cherry-Pick Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.revertCommit",
        "title": "CommitFlow: Revert Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.createBranch",
        "title": "CommitFlow: Create Branch from Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.createTag",
        "title": "CommitFlow: Create Tag from Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.configureAI",
        "title": "CommitFlow: Configure AI",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.openSettings",
        "title": "CommitFlow: Open Settings",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.pull",
        "title": "Pull",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.push",
        "title": "Push",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.sync",
        "title": "Sync",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.fetch",
        "title": "Fetch",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.undoLastCommit",
        "title": "Undo Last Commit",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.stageAll",
        "title": "Stage All Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.unstageAll",
        "title": "Unstage All Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.discardAll",
        "title": "Discard All Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.stash",
        "title": "Stash",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.stashIncludeUntracked",
        "title": "Stash (Include Untracked)",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.stashPopLatest",
        "title": "Pop Latest Stash",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.switchBranch",
        "title": "Switch Branch…",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.openChanges",
        "title": "Open Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.openFile",
        "title": "Open File",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.stage",
        "title": "Stage Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.unstage",
        "title": "Unstage Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.discard",
        "title": "Discard Changes",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.fileHistory",
        "title": "Open File History",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.copyPath",
        "title": "Copy Relative Path",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.scm.file.reveal",
        "title": "Reveal in Explorer View",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.graph.open",
        "title": "Open in CommitFlow",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.graph.copyHash",
        "title": "Copy Commit Hash",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.graph.checkout",
        "title": "Checkout (Detached)",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.graph.createBranch",
        "title": "Create Branch from Here…",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.graph.cherryPick",
        "title": "Cherry Pick",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.graph.revert",
        "title": "Revert Commit",
        "category": "CommitFlow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "commitflow.openDashboard",
          "when": "view == commitflow.sidebar",
          "group": "navigation"
        },
        {
          "command": "commitflow.refresh",
          "when": "view == commitflow.sidebar",
          "group": "navigation"
        },
        {
          "command": "commitflow.scm.pull",
          "when": "view == commitflow.sidebar",
          "group": "1_sync@1"
        },
        {
          "command": "commitflow.scm.push",
          "when": "view == commitflow.sidebar",
          "group": "1_sync@2"
        },
        {
          "command": "commitflow.scm.sync",
          "when": "view == commitflow.sidebar",
          "group": "1_sync@3"
        },
        {
          "command": "commitflow.scm.fetch",
          "when": "view == commitflow.sidebar",
          "group": "1_sync@4"
        },
        {
          "command": "commitflow.scm.undoLastCommit",
          "when": "view == commitflow.sidebar",
          "group": "2_commit@1"
        },
        {
          "command": "commitflow.scm.stageAll",
          "when": "view == commitflow.sidebar",
          "group": "3_changes@1"
        },
        {
          "command": "commitflow.scm.unstageAll",
          "when": "view == commitflow.sidebar",
          "group": "3_changes@2"
        },
        {
          "command": "commitflow.scm.discardAll",
          "when": "view == commitflow.sidebar",
          "group": "3_changes@3"
        },
        {
          "command": "commitflow.scm.stash",
          "when": "view == commitflow.sidebar",
          "group": "4_stash@1"
        },
        {
          "command": "commitflow.scm.stashIncludeUntracked",
          "when": "view == commitflow.sidebar",
          "group": "4_stash@2"
        },
        {
          "command": "commitflow.scm.stashPopLatest",
          "when": "view == commitflow.sidebar",
          "group": "4_stash@3"
        },
        {
          "command": "commitflow.scm.switchBranch",
          "when": "view == commitflow.sidebar",
          "group": "5_branch@1"
        }
      ],
      "editor/title": [
        {
          "command": "commitflow.openFileHistory",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "commitflow.openFileHistory",
          "group": "7_modification",
          "when": "resourceScheme == file && !explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "commitflow.openDashboard"
        },
        {
          "command": "commitflow.refresh"
        },
        {
          "command": "commitflow.search"
        },
        {
          "command": "commitflow.clearFilters"
        },
        {
          "command": "commitflow.openCommit"
        },
        {
          "command": "commitflow.compareCommits"
        },
        {
          "command": "commitflow.openFileHistory"
        },
        {
          "command": "commitflow.viewBranches"
        },
        {
          "command": "commitflow.viewAnalytics"
        },
        {
          "command": "commitflow.checkoutCommit"
        },
        {
          "command": "commitflow.cherryPick"
        },
        {
          "command": "commitflow.revertCommit"
        },
        {
          "command": "commitflow.createBranch"
        },
        {
          "command": "commitflow.createTag"
        },
        {
          "command": "commitflow.configureAI"
        },
        {
          "command": "commitflow.openSettings"
        },
        {
          "command": "commitflow.scm.file.openChanges",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.openFile",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.stage",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.unstage",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.discard",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.fileHistory",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.copyPath",
          "when": "false"
        },
        {
          "command": "commitflow.scm.file.reveal",
          "when": "false"
        },
        {
          "command": "commitflow.graph.open",
          "when": "false"
        },
        {
          "command": "commitflow.graph.copyHash",
          "when": "false"
        },
        {
          "command": "commitflow.graph.checkout",
          "when": "false"
        },
        {
          "command": "commitflow.graph.createBranch",
          "when": "false"
        },
        {
          "command": "commitflow.graph.cherryPick",
          "when": "false"
        },
        {
          "command": "commitflow.graph.revert",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "commitflow.scm.file.openChanges",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-staged|file-changes)$/",
          "group": "navigation@1"
        },
        {
          "command": "commitflow.scm.file.openFile",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-staged|file-changes|file-conflicts)$/",
          "group": "navigation@2"
        },
        {
          "command": "commitflow.scm.file.stage",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-changes|file-conflicts)$/",
          "group": "2_stage@1"
        },
        {
          "command": "commitflow.scm.file.unstage",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-staged)$/",
          "group": "2_stage@1"
        },
        {
          "command": "commitflow.scm.file.discard",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-changes)$/",
          "group": "2_stage@2"
        },
        {
          "command": "commitflow.scm.file.fileHistory",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-staged|file-changes|file-conflicts)$/",
          "group": "3_history@1"
        },
        {
          "command": "commitflow.scm.file.copyPath",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-staged|file-changes|file-conflicts)$/",
          "group": "4_path@1"
        },
        {
          "command": "commitflow.scm.file.reveal",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(file-staged|file-changes|file-conflicts)$/",
          "group": "4_path@2"
        },
        {
          "command": "commitflow.graph.open",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(commit)$/",
          "group": "navigation@1"
        },
        {
          "command": "commitflow.graph.copyHash",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(commit)$/",
          "group": "1_copy@1"
        },
        {
          "command": "commitflow.graph.checkout",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(commit)$/",
          "group": "2_branch@1"
        },
        {
          "command": "commitflow.graph.createBranch",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(commit)$/",
          "group": "2_branch@2"
        },
        {
          "command": "commitflow.graph.cherryPick",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(commit)$/",
          "group": "3_change@1"
        },
        {
          "command": "commitflow.graph.revert",
          "when": "webviewId == 'commitflow.sidebar' && webviewSection =~ /^(commit)$/",
          "group": "3_change@2"
        }
      ]
    },
    "configuration": {
      "title": "CommitFlow",
      "properties": {
        "commitflow.pageSize": {
          "type": "number",
          "default": 30,
          "description": "Number of commits per page."
        },
        "commitflow.defaultViewMode": {
          "type": "string",
          "enum": [
            "grid",
            "list",
            "timeline",
            "graph",
            "analytics"
          ],
          "default": "grid",
          "description": "Default view mode for the CommitFlow dashboard."
        },
        "commitflow.dateFormat": {
          "type": "string",
          "enum": [
            "relative",
            "local",
            "iso"
          ],
          "default": "relative",
          "description": "Default display format for commit timestamps."
        },
        "commitflow.enableAI": {
          "type": "boolean",
          "default": false,
          "description": "Use your AI provider for AI Insights and Smart Search. Add your API key with the CommitFlow: Configure AI command. Commit messages, file names and diffs are sent to the provider. Disabled by default."
        },
        "commitflow.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "custom"
          ],
          "default": "openai",
          "description": "AI provider for commit intelligence. Use custom for any OpenAI-compatible server."
        },
        "commitflow.aiModel": {
          "type": "string",
          "default": "",
          "description": "Model ID to use. Chosen automatically when you add an API key."
        },
        "commitflow.aiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of an OpenAI-compatible server, such as http://localhost:11434/v1. Only used by the custom provider."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "build:ext": "node esbuild.js --production",
    "build:webview": "cd webview-ui && npm run build",
    "build": "node esbuild.js --production && cd webview-ui && npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
